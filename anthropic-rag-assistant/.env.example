# Anthropic API key — console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI API key — platform.openai.com/api-keys  (embeddings only)
OPENAI_API_KEY=

# API auth key — protects /chat and /ingest endpoints.
# Leave blank to disable auth (local dev only).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
RAG_API_KEY=

# Comma-separated list of allowed CORS origins (defaults to localhost).
# Set to your production domain in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Log level for the backend (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
# Set to DEBUG to see per-chunk search hits, embedding batch progress, etc.
LOG_LEVEL=INFO
